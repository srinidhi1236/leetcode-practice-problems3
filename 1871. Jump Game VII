class Solution:
    def canReach(self, s, minJump, maxJump):
        n = len(s)
        reach = [False] * n
        reach[0] = True
        count = 0

        for i in range(1, n):
            if i - minJump >= 0:
                count += reach[i - minJump]

            if i - maxJump - 1 >= 0:
                count -= reach[i - maxJump - 1]

            if s[i] == '0' and count > 0:
                reach[i] = True

        return reach[-1]
